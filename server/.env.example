PORT=5001
NODE_ENV=development

# ---------------------------------------------------------------------------
# SQL Server — pick ONE approach
# ---------------------------------------------------------------------------
#
# (A) Full connection string (best for remote machines / Azure / copy-paste).
#     If set, this is used and the DB_SERVER / DB_* variables below are ignored.
#     Use quotes so semicolons stay in one value. Special chars in password: URL-encode or escape per node-mssql docs.
#
# Remote machine with SQL login (TCP port 1433):
# DB_CONNECTION_STRING="Server=tcp:192.168.1.50,1433;Database=WhiskitDB;User Id=app_user;Password=your_password;Encrypt=true;TrustServerCertificate=true"
#
# Named instance on a host (backslash doubled inside quotes):
# DB_CONNECTION_STRING="Server=tcp:OTHER-PC\\SQLEXPRESS;Database=WhiskitDB;User Id=app_user;Password=your_password;Encrypt=true;TrustServerCertificate=true"
#
# (B) Split variables — local Windows host + named instance, OR use LAN IP from another machine
#
# If the API runs on Mac/Linux, Windows PC names (DESKTOP-…) often fail with ENOTFOUND — set DB_SERVER
# to that machine's IPv4 (see ipconfig on Windows). Remote connections usually need SQL login:
#   DB_TRUSTED_CONNECTION=false
#   DB_USER=...
#   DB_PASSWORD=...
#
# Optional: keep DB_SERVER as the Windows hostname for documentation, and set DB_SERVER_IP to the LAN IPv4
# so Node connects by IP while instance discovery still targets the right machine (SQL Browser / UDP 1434).
# DB_SERVER_IP=192.168.1.50
#
# Host + named instance (same as SSMS "DESKTOP-0P2GD71\MSSQLSERVER01" — here split as SERVER + INSTANCE).
DB_SERVER=DESKTOP-0P2GD71
DB_INSTANCE=MSSQLSERVER01
DB_DATABASE=WhiskitDB

DB_TRUSTED_CONNECTION=true

# DB_USER=
# DB_PASSWORD=

DB_TRUST_SERVER_CERTIFICATE=true
DB_ENABLE_ARITH_ABORT=true

JWT_SECRET=change-me-in-production
